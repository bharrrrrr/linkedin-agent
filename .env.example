# ─────────────────────────────────────────────────────────────────
# OpenAI Agent runtime
# ─────────────────────────────────────────────────────────────────
# Required when using the local OpenAI LinkedIn agent.
# The key is used only by the OpenAI Agents SDK and is never committed.
OPENAI_API_KEY=sk_your_openai_key_here

# Optional model override. The current Agents SDK default is used when omitted.
# OPENAI_MODEL=gpt-5.6-sol

# Optional local state locations.
# LINKEDIN_AGENT_STATE_DIR=.agent-state
# LINKEDIN_AGENT_SESSION_DB=.agent-state/sessions.sqlite3
# LINKEDIN_AGENT_MAX_TURNS=20
# LINKEDIN_AGENT_TRACING=0
# LINKEDIN_AGENT_ALLOW_DIY=1  # only after reviewing your custom poster command

# ─────────────────────────────────────────────────────────────────
# Optional LinkedIn integrations
# ─────────────────────────────────────────────────────────────────
PUBLORA_API_KEY=sk_your_key_here
LINKEDIN_PLATFORM_ID=linkedin-your_id_here
APIFY_TOKEN=apify_api_your_token_here
PIXFARO_TOKEN=pf_live_your_token_here

# Advanced custom poster escape hatch.
# LINKEDIN_SKILLS_CUSTOM_POSTER=python /path/to/my-poster.py
